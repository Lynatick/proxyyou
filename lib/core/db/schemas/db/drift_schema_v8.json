  "fixed_sql": [
    {
      "name": "profile_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile_entries\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"active\" INTEGER NOT NULL CHECK (\"active\" IN (0, 1)), \"name\" TEXT NOT NULL, \"url\" TEXT NULL, \"last_update\" TEXT NOT NULL, \"update_interval\" INTEGER NULL, \"upload\" INTEGER NULL, \"download\" INTEGER NULL, \"total\" INTEGER NULL, \"expire\" TEXT NULL, \"web_page_url\" TEXT NULL, \"support_url\" TEXT NULL, \"populated_headers\" TEXT NULL, \"user_override\" TEXT NULL, \"override_version\" INTEGER NULL, \"override_name\" TEXT NULL, \"override_auto_update_disable\" INTEGER NULL CHECK (\"override_auto_update_disable\" IN (0, 1)), \"override_update_interval\" INTEGER NULL, \"override_extra_security\" TEXT NULL, \"override_fragment\" INTEGER NULL CHECK (\"override_fragment\" IN (0, 1)), \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_proxy_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_proxy_entries\" (\"mode\" TEXT NOT NULL, \"pkg_name\" TEXT NOT NULL, \"flags\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"mode\", \"pkg_name\"));"
        }
      ]
    },
    {
      "name": "profile_headers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile_headers\" (\"profile_id\" TEXT NOT NULL REFERENCES profile_entries (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"ordinal\" INTEGER NOT NULL, \"is_list\" INTEGER NOT NULL CHECK (\"is_list\" IN (0, 1)), \"value\" TEXT NULL, PRIMARY KEY (\"profile_id\", \"name\", \"ordinal\"));"
        }
      ]
    }
