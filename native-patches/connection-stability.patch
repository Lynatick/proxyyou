+	"github.com/sagernet/sing-box/option"
+)
+
+type testOutbound struct {
+	adapter.Outbound
+	tag      string
+	networks []string
+}
+
+func (o testOutbound) Tag() string { return o.tag }
+func (o testOutbound) Network() []string {
+	if o.networks == nil {
+		return []string{"tcp", "udp"}
+	}
+	return o.networks
+}
+func successful(delay uint16) *adapter.URLTestHistory {
+	return &adapter.URLTestHistory{Delay: delay, Time: time.Now()}
+}
+func pool(strategy string, tags ...string) *healthyStrategy {
+	outs := make([]adapter.Outbound, len(tags))
+	for i, tag := range tags {
+		outs[i] = testOutbound{tag: tag}
+	}
+	return newHealthyStrategy(outs, option.BalancerOutboundOptions{Strategy: strategy, Tolerance: 50})
+}
+
+func TestProxyYouAvailabilityVetoBeforeDebouncedPingUpdate(t *testing.T) {
+	for _, strategy := range []string{StrategyRoundRobin, StrategyLowestDelay} {
+		s := pool(strategy, "a", "b")
+		s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"a": successful(10), "b": successful(15)})
+		s.available = func(tag string) bool { return tag != "a" }
+		for i := 0; i < 20; i++ {
+			out := s.Select(adapter.InboundContext{}, "tcp", true)
+			if out == nil || out.Tag() != "b" {
+				t.Fatalf("%s selected a quarantined node", strategy)
+			}
+		}
+		s.available = func(string) bool { return false }
+		if s.Select(adapter.InboundContext{}, "udp", true) != nil {
+			t.Fatal("all-unavailable pool routed a new connection")
+		}
+	}
+}
+
+func TestProxyYouOnlyFreshHealthyServers(t *testing.T) {
+	for _, strategy := range []string{StrategyLowestDelay, StrategyRoundRobin, StrategyConsistentHashing, StrategyStickySessions} {
+		t.Run(strategy, func(t *testing.T) {
