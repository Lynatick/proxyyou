+package dialer
+
+import (
+	"net/netip"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+// Inspect the physical default interface on every resolution. A VPN's own
+// synthetic IPv6 address must not be interpreted as upstream IPv6 support.
+// Missing interface information is unknown, not evidence of an IPv4-only link.
+func interfaceIPv6Available(networkInterface *adapter.NetworkInterface) (available, known bool) {
+	if networkInterface == nil || len(networkInterface.Addresses) == 0 {
+		return false, false
+	}
+	for _, prefix := range networkInterface.Addresses {
+		address := prefix.Addr()
+		if address.Is6() && !address.Is4In6() && address.IsGlobalUnicast() {
+			return true, true
+		}
+	}
+	return false, true
+}
+
+func (d *DefaultDialer) filterDestinationAddresses(addresses []netip.Addr) []netip.Addr {
+	if d.networkManager == nil || d.explicitInterface || len(d.networkType) > 0 || len(d.fallbackNetworkType) > 0 {
+		return addresses
+	}
+	if d.networkManager.DefaultOptions().BindInterface != "" {
+		return addresses
+	}
+	available, known := interfaceIPv6Available(d.networkManager.DefaultNetworkInterface())
+	if !known || available {
+		return addresses
+	}
+	filtered := make([]netip.Addr, 0, len(addresses))
+	for _, address := range addresses {
+		if !address.Is6() || address.Is4In6() || address.IsLoopback() {
+			filtered = append(filtered, address)
+		}
+	}
+	return filtered
+}
+
+func (d *resolveDialer) usableAddresses(addresses []netip.Addr) []netip.Addr {
+	// This capability exists only on a local socket dialer. Never filter remote
+	// destinations forwarded through another proxy, which may have IPv6 itself.
+	if local, ok := d.dialer.(interface {
+		filterDestinationAddresses([]netip.Addr) []netip.Addr
+	}); ok {
+		return local.filterDestinationAddresses(addresses)
+	}
+	return addresses
+}
