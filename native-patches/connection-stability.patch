+func TestProxyYouTwentyPartsKeepEveryNodeAndCachedPriority(t *testing.T) {
+	for _, count := range []int{0, 1, 19, 20, 21, 43, 33726, 65734} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			m := newQueueTestMonitor(t, count, 0)
+			if count > 3 {
+				m.outbounds[m.outboundOrder[1]].history.Delay = 30
+				m.outbounds[m.outboundOrder[3]].history.Delay = 10
+			}
+			tags := m.collectCycleTargets()
+			if len(tags) != count {
+				t.Fatalf("lost nodes: %d/%d", len(tags), count)
+			}
+			seen := make(map[string]bool, count)
+			for _, tag := range tags {
+				if seen[tag] {
+					t.Fatal("duplicate node", tag)
+				}
+				seen[tag] = true
+			}
+			if count > 3 && (tags[0] != m.outboundOrder[3] || tags[1] != m.outboundOrder[1]) {
+				t.Fatal("cached priority lost")
+			}
+		})
+	}
+	m := newQueueTestMonitor(t, 43, 0)
+	tags := m.collectCycleTargets()
+	for part, start := 0, 0; part < 20; part++ {
+		if tags[part] != m.outboundOrder[start] {
+			t.Fatalf("part %d did not contribute to the first wave", part)
+		}
+		size := 43 / 20
+		if part < 43%20 {
+			size++
+		}
+		start += size
+	}
+	// Quarantined servers must not regain priority from their retained raw ping.
+	m.outbounds[m.outboundOrder[42]].history.Delay = 1
+	m.outbounds[m.outboundOrder[42]].availabilityFailed = true
+	if m.collectCycleTargets()[0] == m.outboundOrder[42] {
+		t.Fatal("availability failure gained cached priority")
+	}
+}
