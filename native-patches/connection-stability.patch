+package balancer
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/monitoring"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+)
+
+const (
+	connectionBudget   = 15 * time.Second
+	attemptBudget      = 5 * time.Second
+	connectionAttempts = 3
+	failureCooldown    = 10 * time.Second
+)
+
+// Only a successful test in this process admits a server to automatic routing.
+// A cached result from another network must not bootstrap DNS through a dead node.
+type healthyStrategy struct {
+	mu        sync.Mutex
+	outbounds []adapter.Outbound
+	options   option.BalancerOutboundOptions
+	history   map[string]*adapter.URLTestHistory
+	failed    map[string]time.Time
+	active    []adapter.Outbound
+	strategy  Strategy
+	changed   chan struct{}
+	available func(string) bool
+}
+
+func newHealthyStrategy(outbounds []adapter.Outbound, options option.BalancerOutboundOptions) *healthyStrategy {
+	if options.MaxRetry <= 0 {
+		options.MaxRetry = connectionAttempts
+	}
+	if options.DelayAcceptableRatio < 1 {
+		options.DelayAcceptableRatio = 2
+	}
+	return &healthyStrategy{outbounds: outbounds, options: options,
+		history: make(map[string]*adapter.URLTestHistory), failed: make(map[string]time.Time), changed: make(chan struct{})}
+}
+
+func (s *healthyStrategy) rebuildLocked() bool {
+	now := time.Now()
+	active := make([]adapter.Outbound, 0, len(s.active)+4)
+	for _, out := range s.outbounds {
+		his := s.history[out.Tag()]
+		if his == nil || his.IsFromCache || his.Delay == 0 || his.Delay >= monitoring.TimeoutDelay {
+			continue
+		}
+		if failedAt, ok := s.failed[out.Tag()]; ok {
+			if !his.Time.After(failedAt) && now.Sub(failedAt) < failureCooldown {
+				continue
+			}
+			delete(s.failed, out.Tag())
+		}
+		active = append(active, out)
+	}
+	changed := len(active) != len(s.active)
+	if !changed {
+		for i := range active {
+			if active[i].Tag() != s.active[i].Tag() {
+				changed = true
+				break
+			}
+		}
+	}
+	if changed {
+		s.active = active
+		s.strategy = nil
+		if len(active) > 0 {
+			switch s.options.Strategy {
+			case StrategyRoundRobin:
+				s.strategy = NewRoundRobin(active, s.options)
+			case StrategyConsistentHashing:
+				s.strategy = NewConsistentHashing(active, s.options)
+			case StrategyStickySessions:
+				s.strategy = NewStickySession(active, s.options)
+			case StrategyLowestDelay:
+				s.strategy = NewLowestDelay(active, s.options)
+			}
+		}
+	}
+	if s.strategy != nil {
+		changed = s.strategy.UpdateOutboundsInfo(s.history) || changed
+	}
+	return changed
+}
+
+func (s *healthyStrategy) UpdateOutboundsInfo(history map[string]*adapter.URLTestHistory) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.history = history
+	changed := s.rebuildLocked()
+	close(s.changed)
+	s.changed = make(chan struct{})
+	return changed
+}
+
+func (s *healthyStrategy) fail(tag string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.failed[tag] = time.Now()
+	s.rebuildLocked()
+	close(s.changed)
+	s.changed = make(chan struct{})
+}
+
+func (s *healthyStrategy) selectLocked(metadata adapter.InboundContext, network string, touch bool, tried map[string]bool) adapter.Outbound {
+	if s.strategy == nil {
+		return nil
+	}
+	selected := s.strategy.Select(metadata, network, touch)
+	allowed := func(out adapter.Outbound) bool { return s.available == nil || s.available(out.Tag()) }
+	if selected != nil && !tried[selected.Tag()] && common.Contains(selected.Network(), network) && allowed(selected) {
+		return selected
+	}
+	for _, out := range s.active {
+		if !tried[out.Tag()] && common.Contains(out.Network(), network) && allowed(out) {
+			return out
+		}
+	}
+	return nil
+}
+
+func (s *healthyStrategy) Select(metadata adapter.InboundContext, network string, touch bool) adapter.Outbound {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.selectLocked(metadata, network, touch, nil)
+}
+
+func (s *healthyStrategy) wait(ctx context.Context, metadata adapter.InboundContext, network string, tried map[string]bool) (adapter.Outbound, error) {
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		s.mu.Lock()
+		selected := s.selectLocked(metadata, network, true, tried)
+		changed := s.changed
+		s.mu.Unlock()
+		if selected != nil {
+			return selected, nil
+		}
+		// Health updates are debounced. A backup's successful test may already
+		// be complete while its group notification is still pending. Wait within
+		// the caller's budget; never retry a node already tried by this request.
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-changed:
+		}
+	}
+}
+
+func (s *healthyStrategy) Now() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.strategy == nil {
+		return ""
+	}
+	return s.strategy.Now()
+}
+
+// Shared by TCP and packet establishment. Never replay application bytes or
+// migrate an existing connection after its transport has been established.
+func establish[T any](ctx context.Context, strategy *healthyStrategy, metadata adapter.InboundContext, network string,
+	dial func(context.Context, adapter.Outbound) (T, error), failed func(string)) (T, error) {
+	var zero T
+	ctx, cancel := context.WithTimeout(ctx, connectionBudget)
+	defer cancel()
+	tried := make(map[string]bool, connectionAttempts)
+	var lastErr error
+	for attempt := 0; attempt < connectionAttempts; attempt++ {
+		out, err := strategy.wait(ctx, metadata, network, tried)
+		if err != nil {
+			if lastErr != nil && ctx.Err() == nil {
+				return zero, lastErr
+			}
+			return zero, err
+		}
+		tried[out.Tag()] = true
+		attemptCtx, stop := context.WithTimeout(ctx, attemptBudget)
+		result, err := dial(attemptCtx, out)
+		stop()
+		if err == nil {
+			return result, nil
+		}
+		lastErr = err
+		if ctx.Err() != nil {
+			return zero, ctx.Err()
+		}
+		strategy.fail(out.Tag())
+		if failed != nil {
+			failed(out.Tag())
+		}
+	}
+	return zero, lastErr
+}
+
+var _ Strategy = (*healthyStrategy)(nil)
