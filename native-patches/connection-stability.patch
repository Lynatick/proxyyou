+func newQueueTestMonitor(t *testing.T, count, workers int) *OutboundMonitoring {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	m := &OutboundMonitoring{ctx: ctx, cancel: cancel, mainInterval: time.Hour, urlTestTimeout: time.Minute,
+		urls: []string{defaultURLTest}, logger: log.NewNOPFactory().Logger(), history: urltest.NewHistoryStorage(),
+		outbounds: make(map[string]*outboundState, count), groups: make(map[string]*groupState)}
+	for i := 0; i < count; i++ {
+		tag := fmt.Sprintf("node-%06d", i)
+		out := &queueTestOutbound{tag: tag}
+		out.ready.Store(true)
+		m.outbounds[tag] = &outboundState{outbound: out, invalid: true}
+		m.outboundOrder = append(m.outboundOrder, tag)
+	}
+	for i := 0; i < workers; i++ {
+		m.workerWG.Add(1)
+		go m.workerLoop()
+	}
+	t.Cleanup(func() { m.Close() })
+	return m
+}
