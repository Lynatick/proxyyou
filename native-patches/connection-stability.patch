+package monitoring
+
+import (
+	"container/list"
+	"sort"
+	"sync"
+	"time"
+)
+
+// Jobs are bounded by the number of registered outbounds, not by an arbitrary
+// channel capacity. The shared worker pool remains limited to 20 probes.
+type testTaskQueue struct {
+	mu       sync.Mutex
+	priority list.List
+	normal   list.List
+	ready    chan struct{}
+	closed   bool
+}
+
+func newTestTaskQueue() *testTaskQueue { return &testTaskQueue{ready: make(chan struct{}, 1)} }
+
+func (q *testTaskQueue) notify() {
+	select {
+	case q.ready <- struct{}{}:
+	default:
+	}
+}
+
+func (q *testTaskQueue) push(task *testTask) bool {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed || task.element != nil {
+		return false
+	}
+	if task.priority {
+		task.element = q.priority.PushBack(task)
+	} else {
+		task.element = q.normal.PushBack(task)
+	}
+	q.notify()
+	return true
+}
+
+// Promote the original task, retaining its cycle result channel. A manual
+// recheck never starts a duplicate probe or strands the background collector.
+func (q *testTaskQueue) promote(task *testTask) bool {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed || task.element == nil || task.priority {
+		return false
+	}
+	q.normal.Remove(task.element)
+	task.priority = true
+	task.element = q.priority.PushBack(task)
+	q.notify()
+	return true
+}
+
+func (q *testTaskQueue) pop() *testTask {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed {
+		return nil
+	}
+	queue := &q.priority
+	if queue.Len() == 0 {
+		queue = &q.normal
+	}
+	front := queue.Front()
+	if front == nil {
+		return nil
+	}
+	task := queue.Remove(front).(*testTask)
+	task.element = nil
+	if q.priority.Len()+q.normal.Len() > 0 {
+		q.notify() // Wake another idle worker even after one bulk submission.
+	}
+	return task
+}
+
+func (q *testTaskQueue) close() []*testTask {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	q.closed = true
+	var pending []*testTask
+	for _, queue := range []*list.List{&q.priority, &q.normal} {
+		for element := queue.Front(); element != nil; {
+			next := element.Next()
+			task := element.Value.(*testTask)
+			task.element = nil
+			pending = append(pending, task)
+			element = next
+		}
+		queue.Init()
+	}
+	return pending
+}
+
+func (m *OutboundMonitoring) taskQueue() *testTaskQueue {
+	m.queueOnce.Do(func() { m.tasks = newTestTaskQueue() })
+	return m.tasks
+}
+
+func (m *OutboundMonitoring) retryWhenReady(task *testTask) {
+	state := m.outbounds[task.outboundTag]
+	state.mu.Lock()
+	if state.retryPending || m.ctx.Err() != nil {
+		state.mu.Unlock()
+		return
+	}
+	state.retryPending = true
+	state.mu.Unlock()
+	retry := &testTask{outboundTag: task.outboundTag, cycleID: task.cycleID,
+		priority: task.priority, readinessRetries: task.readinessRetries + 1}
+	m.retryWG.Add(1) // Called by a worker; Close waits workers before retries.
+	go func() {
+		defer m.retryWG.Done()
+		timer := time.NewTimer(3 * time.Second)
+		defer timer.Stop()
+		select {
+		case <-m.ctx.Done():
+		case <-timer.C:
+		}
+		state.mu.Lock()
+		state.retryPending = false
+		state.mu.Unlock()
+		if m.ctx.Err() == nil {
+			m.enqueueTask(retry)
+		}
+	}()
+}
+
+// Previously successful nodes go first. Then take one node from each of 20
+// balanced contiguous parts; workers freely share all parts through one queue.
+func interleaveTestTargets(tags []string, delays map[string]uint16) []string {
+	ordered := make([]string, 0, len(tags))
+	for _, tag := range tags {
+		if delay := delays[tag]; delay > 0 && delay < TimeoutDelay {
+			ordered = append(ordered, tag)
+		}
+	}
+	sort.SliceStable(ordered, func(i, j int) bool { return delays[ordered[i]] < delays[ordered[j]] })
+	parts := min(defaultWorkerCount, len(tags))
+	if parts == 0 {
+		return ordered
+	}
+	starts, sizes := make([]int, parts), make([]int, parts)
+	for part, start := 0, 0; part < parts; part++ {
+		starts[part], sizes[part] = start, len(tags)/parts
+		if part < len(tags)%parts {
+			sizes[part]++
+		}
+		start += sizes[part]
+	}
+	for row := 0; row < sizes[0]; row++ {
+		for part, start := range starts {
+			if row < sizes[part] {
+				tag := tags[start+row]
+				if delay := delays[tag]; delay == 0 || delay >= TimeoutDelay {
+					ordered = append(ordered, tag)
+				}
+			}
+		}
+	}
+	return ordered
+}
+
+func (m *OutboundMonitoring) sourceOrder() []string {
+	if len(m.outboundOrder) > 0 {
+		return m.outboundOrder
+	}
+	// Deterministic fallback for stand-alone fixtures; production registers the
+	// exact subscription order before starting any worker.
+	tags := make([]string, 0, len(m.outbounds))
+	for tag := range m.outbounds {
+		tags = append(tags, tag)
+	}
+	sort.Strings(tags)
+	return tags
+}
+
+func (m *OutboundMonitoring) groupTestTargets(tag string) []string {
+	leaves, visited := make(map[string]bool), make(map[string]bool)
+	var visit func(string)
+	visit = func(tag string) {
+		if visited[tag] {
+			return
+		}
+		visited[tag] = true
+		if group := m.groups[tag]; group != nil {
+			for child := range group.outbounds {
+				visit(child)
+			}
+		} else if m.outbounds[tag] != nil {
+			leaves[tag] = true
+		}
+	}
+	visit(tag)
+	tags, delays := make([]string, 0, len(leaves)), make(map[string]uint16, len(leaves))
+	for _, tag := range m.sourceOrder() {
+		if !leaves[tag] {
+			continue
+		}
+		tags = append(tags, tag)
+		state := m.outbounds[tag]
+		state.mu.Lock()
+		if !state.availabilityFailed {
+			delays[tag] = state.history.Delay
+		}
+		state.mu.Unlock()
+	}
+	return interleaveTestTargets(tags, delays)
+}
