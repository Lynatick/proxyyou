+func TestNativeAutomaticEstablishmentFailover(t *testing.T) {
+	for _, strategy := range []string{"lowest-delay", "round-robin", "consistent-hashing", "sticky-sessions"} {
+		t.Run(strategy, func(t *testing.T) {
+			health, cert := healthServer(t)
+			a, b := newEndpoint(t, "a", health), newEndpoint(t, "b", health)
+			a.delay.Store(20)
+			b.delay.Store(400)
+			registry := include.OutboundRegistry()
+			var nativeCtx context.Context
+			outbound.Register[struct{}](registry, "continuity-test", func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ struct{}) (adapter.Outbound, error) {
+				nativeCtx = ctx
+				if tag == "a" {
+					return a, nil
+				}
+				return b, nil
+			})
+			ctx := box.Context(context.Background(), include.InboundRegistry(), registry, include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry())
+			instance, err := box.New(box.Options{Context: ctx, Options: option.Options{
+				Log: &option.LogOptions{Disabled: true}, Certificate: &option.CertificateOptions{Store: "none", Certificate: []string{cert}},
+				Route:        &option.RouteOptions{Final: "automatic"},
+				Experimental: &option.ExperimentalOptions{Monitoring: &option.MonitoringOptions{Interval: badoption.Duration(time.Hour), URLTestTimeout: badoption.Duration(2 * time.Second), DebounceWindow: badoption.Duration(10 * time.Millisecond)}},
+				Outbounds: []option.Outbound{
+					{Type: "balancer", Tag: "automatic", Options: &option.BalancerOutboundOptions{Outbounds: []string{"a", "b"}, Strategy: strategy, DelayAcceptableRatio: 1}},
+					{Type: "continuity-test", Tag: "a", Options: &struct{}{}}, {Type: "continuity-test", Tag: "b", Options: &struct{}{}},
+				},
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = instance.Start(); err != nil {
+				instance.Close()
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { instance.Close() })
+			monitor := monitoring.Get(nativeCtx)
+			deadline := time.Now().Add(5 * time.Second)
+			for {
+				h := monitor.OutboundsHistory("automatic")
+				if h["a"] != nil && h["b"] != nil && h["a"].Delay > 0 && h["b"].Delay > 0 && h["b"].Delay < 65535 {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatal("health tests not completed")
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			out, _ := instance.Outbound().Outbound("automatic")
+			traffic := interrupt.ContextWithIsExternalConnection(context.Background())
+			dest := M.ParseSocksaddr("127.0.0.1:9")
+			old, err := out.DialContext(traffic, "tcp", dest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer old.Close()
+			if tag, err := readTag(old); err != nil || tag != "a" {
+				t.Fatalf("initial TCP: %s %v", tag, err)
+			}
+			a.failTCP.Store(true)
+			a.failUDP.Store(true)
+			// Exercise the actual inbound handler, not only the direct DialContext API.
+			client, server := net.Pipe()
+			defer client.Close()
+			go out.(adapter.ConnectionHandlerEx).NewConnectionEx(traffic, server, adapter.InboundContext{Network: "tcp", Destination: dest}, nil)
+			if tag, err := readTag(client); err != nil || tag != "b" {
+				t.Fatalf("inbound TCP did not fail over: %s %v", tag, err)
+			}
+			if err := exchangeTCP(old); err != nil {
+				t.Fatalf("retry interrupted established TCP: %v", err)
+			}
+			packet, err := out.ListenPacket(traffic, dest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer packet.Close()
+			if tag, err := exchangeUDP(packet); err != nil || tag != "b" {
+				t.Fatalf("packet establishment did not fail over: %s %v", tag, err)
+			}
+		})
+	}
+}
