+type queueTestOutbound struct {
+	adapter.Outbound
+	tag          string
+	ready        atomic.Bool
+	calls        atomic.Int32
+	gate         <-chan struct{}
+	entered      chan<- struct{}
+	active, peak *atomic.Int32
+}
+
+func (o *queueTestOutbound) Tag() string   { return o.tag }
+func (o *queueTestOutbound) IsReady() bool { return o.ready.Load() }
+func (o *queueTestOutbound) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	o.calls.Add(1)
+	if o.active != nil {
+		n := o.active.Add(1)
+		defer o.active.Add(-1)
+		for {
+			old := o.peak.Load()
+			if n <= old || o.peak.CompareAndSwap(old, n) {
+				break
+			}
+		}
+	}
+	if o.entered != nil {
+		select {
+		case o.entered <- struct{}{}:
+		default:
+		}
+	}
+	if o.gate != nil {
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-o.gate:
+		}
+	}
+	return nil, errors.New("controlled offline proxy")
+}
