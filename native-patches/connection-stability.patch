+
+type testNetworkManager struct {
+	adapter.NetworkManager
+	current *adapter.NetworkInterface
+}
+
+func (m *testNetworkManager) DefaultOptions() adapter.NetworkOptions { return adapter.NetworkOptions{} }
+
+func (m *testNetworkManager) DefaultNetworkInterface() *adapter.NetworkInterface { return m.current }
+func physical(prefixes ...string) *adapter.NetworkInterface {
+	n := &adapter.NetworkInterface{Interface: control.Interface{Name: "physical"}}
+	for _, prefix := range prefixes {
+		n.Addresses = append(n.Addresses, netip.MustParsePrefix(prefix))
+	}
+	return n
+}
+
+func TestProxyYouPhysicalIPv6Availability(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		n                *adapter.NetworkInterface
+		available, known bool
+	}{
+		{"unknown", nil, false, false}, {"no-addresses", physical(), false, false},
+		{"ipv4-only", physical("192.0.2.5/24"), false, true},
+		{"link-local-only", physical("192.0.2.5/24", "fe80::1/64"), false, true},
+		{"dual-stack", physical("192.0.2.5/24", "2001:db8::5/64"), true, true},
+		{"ipv6-only-nat64", physical("2001:db8::5/64"), true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			a, k := interfaceIPv6Available(tc.n)
+			if a != tc.available || k != tc.known {
+				t.Fatalf("%v %v", a, k)
+			}
+		})
+	}
+}
+
+func TestProxyYouIPv6FilteringTracksNetworkChanges(t *testing.T) {
+	addresses := []netip.Addr{netip.MustParseAddr("2001:db8::1"), netip.MustParseAddr("192.0.2.1")}
+	m := &testNetworkManager{current: physical("192.0.2.5/24")}
+	d := &DefaultDialer{networkManager: m}
+	if got := d.filterDestinationAddresses(addresses); !reflect.DeepEqual(got, addresses[1:]) {
+		t.Fatal(got)
+	}
+	m.current = physical("2001:db8::5/64")
+	if got := d.filterDestinationAddresses(addresses); !reflect.DeepEqual(got, addresses) {
+		t.Fatal("IPv6 did not recover", got)
+	}
+	m.current = nil
+	if got := d.filterDestinationAddresses(addresses); !reflect.DeepEqual(got, addresses) {
+		t.Fatal("unknown network discarded IPv6", got)
+	}
+	m.current = physical("192.0.2.5/24")
+	d.explicitInterface = true
+	if got := d.filterDestinationAddresses(addresses); !reflect.DeepEqual(got, addresses) {
+		t.Fatal("explicit interface ignored", got)
+	}
+}
